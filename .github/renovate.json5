{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>trueforge-org/truecharts//.github/renovate/main.json5"
  ],
  "ignorePresets": [
    "github>trueforge-org/truecharts//.github/renovate/basics/labels.json5"
  ],
  "assignees": ["kleinarne"],
  "timezone": "Europe/Berlin",
  "flux": {
    "fileMatch": ["/\\.yaml(?:\\.j2)?$/"]
  },
  "packageRules": [
    {
      "description": ["Pin kubelet to the 1.36.x line until the coordinated Talos 1.14 + k8s 1.37 upgrade (rationale: PR #12 close comment)."],
      "matchPackageNames": ["ghcr.io/siderolabs/kubelet"],
      "allowedVersions": ["1.36.x"]
    },
    {
      "description": ["Keep major updates manual, regardless of package."],
      "matchUpdateTypes": ["major"],
      "addLabels": ["type/major"],
      "automerge": false
    },